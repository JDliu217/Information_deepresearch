# 真实 LLM（OpenAI 兼容接口）
# 复制本文件为项目根目录的 .env，再填写密钥。
# .env 已被 .gitignore 忽略，不能提交到 Git。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v3.2
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# 可选：给某个 Agent 指定不同模型；不填写时使用 LLM_MODEL
# LLM_PLANNER_MODEL=
# LLM_FACT_MODEL=
# LLM_ANALYST_MODEL=
# LLM_WIZARD_MODEL=
# LLM_WRITER_MODEL=
# LLM_CRITIC_MODEL=

# Bocha Web Search
BOCHA_API_KEY=
BOCHA_ENDPOINT=https://api.bocha.cn/v1/web-search
BOCHA_TIMEOUT_SECONDS=30
BOCHA_MAX_RETRIES=2
BOCHA_FRESHNESS=noLimit
BOCHA_FETCH_CONTENT=1
BOCHA_MAX_CONTENT_CHARS=20000
BOCHA_FETCH_CONCURRENCY=4

# PostgreSQL（仅在接入持久化 Repository 时使用）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/information_deepresearch
DATABASE_ECHO=0
