# 真实 LLM（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v3.2
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Bocha Web Search
BOCHA_API_KEY=
BOCHA_ENDPOINT=https://api.bocha.cn/v1/web-search
BOCHA_TIMEOUT_SECONDS=30
BOCHA_MAX_RETRIES=2
BOCHA_FETCH_CONTENT=1
BOCHA_MAX_CONTENT_CHARS=20000
BOCHA_FETCH_CONCURRENCY=4
