# 真实 LLM（OpenAI 兼容接口）
# 复制本文件为项目根目录的 .env，再填写密钥。
# .env 已被 .gitignore 忽略，不能提交到 Git。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v3.2
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
# DeepSeek 思考模式默认关闭，避免 reasoning_content 占满结构化输出预算。
LLM_THINKING=disabled
# 仅当 LLM_THINKING=enabled 时使用；可选值：none、low、medium、high。
LLM_REASONING_EFFORT=none

# 可选：按 Agent 覆盖思考开关或推理强度；不填写时使用上面的全局值。
# LLM_FACT_THINKING=disabled
# LLM_FACT_REASONING_EFFORT=none

# 可选：给某个 Agent 指定不同模型；不填写时使用 LLM_MODEL
# LLM_PLANNER_MODEL=
# LLM_FACT_MODEL=
# LLM_ANALYST_MODEL=
# LLM_WIZARD_MODEL=
# LLM_WRITER_MODEL=
# LLM_CRITIC_MODEL=

# Bocha Web Search
BOCHA_API_KEY=
BOCHA_ENDPOINT=https://api.bocha.cn/v1/web-search
BOCHA_TIMEOUT_SECONDS=30
BOCHA_MAX_RETRIES=2
BOCHA_FRESHNESS=noLimit
# 原项目常规研究使用搜索摘要；设为 1 才会额外抓取网页正文。
BOCHA_FETCH_CONTENT=0
BOCHA_MAX_CONTENT_CHARS=20000
BOCHA_FETCH_CONCURRENCY=4

# Critic 最多触发的补充研究与修订轮数；0 表示只生成初稿并审核一次。
RESEARCH_MAX_ITERATIONS=3

# PostgreSQL（配置后，API 和命令行研究运行会自动保存状态、事件和报告）
# 先启动 PostgreSQL 并创建 information_deepresearch 数据库，再设置连接地址：
# DATABASE_URL=postgresql+psycopg://postgres:替换为你的密码@localhost:5432/information_deepresearch
DATABASE_ECHO=0
